# Keep text files with LF endings so that the repository behaves the same
# on every platform. Godot reads both, but a consistent checkout avoids
# noisy diffs and keeps the .uid files byte-identical.
* text=auto eol=lf

*.gd text eol=lf
*.uid text eol=lf
*.cfg text eol=lf
*.godot text eol=lf
*.tscn text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.bat text eol=lf
*.sh text eol=lf

*.png binary
*.gif binary
*.zip binary
